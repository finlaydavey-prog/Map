# Not needed for the mock prototype — the app runs with zero keys.
# These are the slots the real providers will read from (see src/lib/providers/isochrone.ts).

# Mapbox: map tiles/style + Isochrone API (drive / walk / cycle) + Geocoding
VITE_MAPBOX_TOKEN=

# Option A for transit isochrones (approximated_transit mode)
VITE_GEOAPIFY_KEY=

# Option B for transit: TfL Unified API (line geometry, stations, journey times)
VITE_TFL_APP_KEY=
